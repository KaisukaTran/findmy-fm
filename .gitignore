
# Python
.venv/
__pycache__/
*.pyc

# Environment
.env

# Database
*.db
*.db-journal
*.db-wal
*.db-shm

# Local DB + settings backups (never commit; may contain secrets from .env)
data/backups/
# Ad-hoc DB snapshots written straight into data/ by the phantom/adopt scripts
# (named findmy.db.bak-<tag>-<ts>) — the *.db globs above don't catch the .bak suffix.
data/*.bak*
*.bak-*

# OS
.DS_Store

# SOT runtime data
data/sot/*.db

# Runtime databases (SOT)
*.db
data/sot/*.db
.coverage

# Dev server logs
*.log
logs_uvicorn.*

# Local Claude Code tooling skills (generic, not project-specific — the
# FINDMY-FM skills under .claude/skills/ stay tracked).
.claude/skills/context-budget/
.claude/skills/harness-plan/
